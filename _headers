# Cloudflare Pages response headers.
#
# Flutter's service worker only picks up a new release when the browser
# re-fetches these entry files. Serving them with no-cache means every
# visit checks for a new deploy instead of holding the old app for hours.
# The hashed assets (main.dart.js, canvaskit, fonts) stay cacheable; the
# service worker manifest already versions them by content hash.
/index.html
  Cache-Control: no-cache, must-revalidate
/flutter_service_worker.js
  Cache-Control: no-cache, must-revalidate
/flutter_bootstrap.js
  Cache-Control: no-cache, must-revalidate
/flutter.js
  Cache-Control: no-cache, must-revalidate
/version.json
  Cache-Control: no-cache, must-revalidate
/manifest.json
  Cache-Control: no-cache, must-revalidate
# Fonts, images and the renderer change only with a Flutter or asset
# update, and the service worker refetches changed files by content hash.
/assets/*
  Cache-Control: public, max-age=604800
/canvaskit/*
  Cache-Control: public, max-age=604800
